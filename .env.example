# ==============================================================================
# QueueSense — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your deployment environment.
# DO NOT commit .env containing real secrets to version control.
# ==============================================================================

# Database Configuration
POSTGRES_DB=jobflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection Strings (For local host backend execution)
# Note: Inside Docker Compose, the host is automatically 'postgres'
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=jobflow;Username=postgres;Password=postgres_dev_password_change_me;Include Error Detail=true

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# JWT Authentication (Change secret key in production!)
JWT_SECRET=QueueSense-SecretKey-MustBeAtLeast32CharactersLong!2026
Jwt__Issuer=JobFlowApi
Jwt__Audience=JobFlowClient
Jwt__ExpirationMinutes=1440

# AI Provider Configuration (Mock, OpenAI, Ollama)
AI_PROVIDER=Mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI__OpenAI__BaseUrl=https://api.openai.com/v1
AI__Ollama__BaseUrl=http://localhost:11434
AI__Ollama__Model=llama3

# Background Worker Configuration
Worker__PollingIntervalSeconds=2
Worker__LeaseDurationMinutes=5
Worker__MaxConcurrency=4
